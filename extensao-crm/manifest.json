{
  "manifest_version": 3,
  "name": "CRM WhatsApp",
  "version": "0.10.3",
  "description": "CRM dentro do WhatsApp Web: cadastro, Kanban, renovação, respostas rápidas e agendamentos.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["page/config.js", "vendor/wppconnect-wa.js", "page/bridge.js"],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": [
        "content/util.js",
        "content/store.js",
        "content/wa.js",
        "content/audio.js",
        "content/styles.js",
        "content/ui.js",
        "content/quick.js",
        "content/quickrun.js",
        "content/runbar.js",
        "content/layout.js",
        "content/tabs.js",
        "content/rail.js",
        "content/schedules.js",
        "content/renewals.js",
        "content/remarketing.js",
        "content/clients.js",
        "content/notes.js",
        "content/contactname.js",
        "content/chattabs.js",
        "content/quickpanel.js",
        "content/composer.js",
        "content/panel.js",
        "content/backup.js",
        "content/settings.js",
        "content/main.js"
      ],
      "run_at": "document_end"
    }
  ]
}
